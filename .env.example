# Database Configuration
POSTGRES_DB=hospital_command_center
POSTGRES_USER=hospital
POSTGRES_PASSWORD=your_secure_password_here

# Backend Configuration
ENVIRONMENT=production
SECRET_KEY=your_secure_random_string_here_minimum_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS and Frontend
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
FRONTEND_URL=https://yourdomain.com

# SMTP Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=noreply@yourhospital.com

# Auto-seeding (Set to true for initial deployment with demo data)
AUTO_SEED=false

# API Base URL (Frontend environment variable)
NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com
